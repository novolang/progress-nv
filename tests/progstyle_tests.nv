// progstyle_tests.nv — the glyphs, and the spinner that has no counter.
//
// RED ON PURPOSE: every body under `src/` is a `todo()`, so every
// assertion here reaches `not implemented: progress-nv.<module>.<fn>`.
//
// THE SPINNER TEST IS THE ONE THAT MATTERS.  A spinner frame here is a
// function of the instant, so two spinners drawn in one frame are in
// step and a replay looks the way the run looked — and that is a
// property two calls can assert.  An implementation that kept an index
// could not.

use std.test
use std.str
use std.list
use progstyle

@test
fn test_the_spinner_frame_is_a_function_of_the_instant() [io]
    let s = progstyle.style()

    test.case("the same instant gives the same frame")
    test.assert(progstyle.spinner_frame(s, 1.5) == progstyle.spinner_frame(s, 1.5))

    test.case("two bars drawn in one frame are in step")
    test.assert(progstyle.spinner_frame(s, 2.25) == progstyle.spinner_frame(s, 2.25))

    test.case("and a whole number of periods later it is the same frame again")
    let period = s.spinner_period * list.len(s.spinner)
    test.assert(progstyle.spinner_frame(s, 0.0) == progstyle.spinner_frame(s, period))

@test
fn test_a_dropped_tick_does_not_skip_a_frame() [io]
    // The bug every index-keeping spinner has: a redraw that was
    // throttled away makes the next frame jump.  Here the frame is the
    // instant's, so nothing can be skipped.
    let s = progstyle.style()

    test.case("the frame at 1.0 does not depend on whether 0.5 was drawn")
    test.assert(progstyle.spinner_frame(s, 1.0) == progstyle.spinner_frame(s, 1.0))

@test
fn test_a_bar_is_exactly_the_width_it_was_asked_for() [io]
    // Including the ends, so a style with brackets and one without both
    // fit the column they were given.
    test.case("twenty cells")
    test.assert(str.len(progstyle.bar(progstyle.ascii(), 20, 0.5)) == 20)

    test.case("zero cells is the empty string and not a crash")
    test.assert(progstyle.bar(progstyle.ascii(), 0, 0.5) == "")

@test
fn test_a_fraction_outside_the_range_is_clamped() [io]
    // A length that was an estimate is normal; a bar that drew past its
    // own end is not.
    let s = progstyle.ascii()

    test.case("past the end draws a full bar")
    test.assert(progstyle.bar(s, 10, 2.0) == progstyle.bar(s, 10, 1.0))

    test.case("and below zero draws an empty one")
    test.assert(progstyle.bar(s, 10, 0.0 - 1.0) == progstyle.bar(s, 10, 0.0))

@test
fn test_the_partial_blocks_are_why_a_unicode_bar_looks_alive() [io]
    // An ASCII bar 20 cells wide over 10,000 items redraws identically
    // for 500 of them, and that is what "my bar looks stuck" is.
    test.case("ASCII has one position per cell")
    test.assert(progstyle.filled_parts(progstyle.ascii(), 20) == 20)

    test.case("and the Unicode style has eight")
    test.assert(progstyle.filled_parts(progstyle.style(), 20) == 160)

@test
fn test_a_style_says_whether_it_is_safe_for_a_log_file() [io]
    test.case("the ASCII style is")
    test.assert(progstyle.is_ascii(progstyle.ascii()))

    test.case("the default one is not")
    test.assert(progstyle.is_ascii(progstyle.style()) == false)

@test
fn test_a_style_is_built_one_field_at_a_time() [io]
    let base = progstyle.style()

    test.case("with_chars replaces the two bar characters")
    test.assert(progstyle.with_chars(base, "=", ".").filled == "=")
    test.assert(progstyle.with_chars(base, "=", ".").empty == ".")

    test.case("with_partials replaces the partial run")
    test.assert(list.len(progstyle.with_partials(base, []).partials) == 0)

    test.case("with_ends puts brackets on it")
    test.assert(progstyle.with_ends(base, "[", "]").open == "[")

    test.case("and with_spinner replaces the frames and the period")
    let spun = progstyle.with_spinner(base, [".", "o", "O"], 0.2)
    test.assert(list.len(spun.spinner) == 3)
    test.assert(spun.spinner_period == 0.2)

@test
fn test_the_spinner_only_style_has_no_bar() [io]
    test.case("no partials")
    test.assert(list.len(progstyle.spinner_only().partials) == 0)

    test.case("but it still has frames")
    test.assert(list.len(progstyle.spinner_only().spinner) > 0)

@test
fn test_a_finished_line_keeps_its_shape() [io]
    // The spinner column does not collapse, so a list of completed
    // steps stays aligned with the ones still running.
    test.case("a finished frame is one glyph")
    test.assert(str.len(progstyle.finished_frame(progstyle.style())) > 0)

    test.case("an abandoned one is a different glyph")
    test.assert(progstyle.abandoned_frame(progstyle.style())
                != progstyle.finished_frame(progstyle.style()))

@test
fn test_the_buffer_form_and_the_string_form_agree() [io]
    let out = progstyle.bar_into([], progstyle.ascii(), 20, 0.5)

    test.case("same length")
    test.assert(list.len(out) == str.len(progstyle.bar(progstyle.ascii(), 20, 0.5)))
